# Entorno y Base de Datos (SQLite en dev, PostgreSQL en prod: postgresql://user:pass@localhost:5432/unla_prestamos)
DATABASE_URL="file:./dev.db"

# Autenticación y Dominio Institucional
NEXTAUTH_URL="https://prestamoequipos.comunidaio.com"
NEXTAUTH_SECRET="tu-clave-secreta-aleatoria-generada"
ALLOWED_GOOGLE_DOMAIN="unla.edu.ar"

# Proveedor Google OAuth
GOOGLE_CLIENT_ID="tu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-google-client-secret"

# Configuración SMTP para Notificaciones (Gmail)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="dircomunla@gmail.com"
SMTP_PASS="lypkcdzicpqkiclb"
SMTP_FROM="Secretaría de Cultura y Comunicación UNLa <dircomunla@gmail.com>"

# Parámetros del Sistema
APP_TITLE="Préstamo de Equipamiento Audiovisual - UNLa"
APP_ACCENT_COLOR="#4F46E5"
TIMEZONE="America/Argentina/Buenos_Aires"
BUFFER_DAYS="1"
